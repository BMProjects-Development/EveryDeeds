{
    "schemaVersion": 1,

    "id"     : "everydeeds",
    "version": "${version}",
    "name"   : "EveryDeeds",

    "description": "Tracks everything you do with every block, item, mob, biome, dimension, structure and effect: an achievement ledger far beyond vanilla statistics.",
    "authors"    : [ "Claude (Anthropic)" ],
    "contributors": [ "_BENDY659_ (idea, design, testing)" ],
    "contact"    : {},
    "license"    : "MIT",
    "icon"       : "assets/everydeeds/icon.png",

    "environment": "*",
    "entrypoints": {
        "fabric-datagen": [ "ru.benos.everydeeds.client.EveryDeedsDataGenerator" ],

        "client": [ { "adapter": "kotlin", "value"  : "ru.benos.everydeeds.client.EveryDeedsClient" } ],
        "main"  : [ { "adapter": "kotlin", "value"  : "ru.benos.everydeeds.EveryDeeds" } ],
        "modmenu": [ { "adapter": "kotlin", "value"  : "ru.benos.everydeeds.client.compat.ModMenuIntegration" } ]
    },
    "mixins": [
        "everydeeds.mixins.json",
        { "config": "everydeeds.client.mixins.json", "environment": "client" }
    ],
    "depends": {
        "minecraft": "${minecraft_version}",

        "fabricloader": ">=${loader_version}",
        "fabric-api"  : "*",

        "fabric-language-kotlin": ">=${kotlin_loader_version}"
    },
    "suggests": {
        "modmenu": "*"
    }
}
